# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=your-api-key-here
# Needed for Vertex-Express style keys (AQ. prefix): the SDK otherwise routes
# them to the Vertex AI backend where they fail auth. Harmless for AIza keys.
GOOGLE_GENAI_USE_VERTEXAI=False
# Optional overrides (defaults shown). Verify availability: python resume_matcher.py --list-models
# gemini-2.5-flash is retired for new users; pick a current Flash model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_S=90
GEMINI_MAX_RETRIES=4
GEMINI_DEADLINE_S=120
MAX_INPUT_CHARS=20000
